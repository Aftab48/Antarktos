{
  "name": "antarktos",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check:step2": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/step2/check.ts",
    "check:step3": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/step3/check.ts --",
    "check:step4b": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/step4b/check.ts",
    "check:step5": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/step5/check.ts --",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "dataset:collect": "node scripts/dataset/run-all.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "pipeline:process": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/pipeline/process.ts --",
    "pipeline:stuck": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/pipeline/stuck.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:pipeline": "node --import tsx --test src/pipeline/text.test.ts",
    "test:search": "node --import tsx --test src/search/*.test.ts",
    "users:test": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/step2/test-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "next": "16.3.3",
    "openai": "^7.23.0",
    "payload": "3.90.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tw-animate-css": "^1.4.0",
    "twitter-text": "3.1.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
